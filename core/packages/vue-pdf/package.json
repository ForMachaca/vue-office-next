{
  "name": "@formachaca/vue-office-pdf",
  "version": "2.0.11",
  "description": "Vue 3 PDF preview with an isolated PDF.js runtime",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "LICENSE-PDFJS",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "vite build && cp index.d.ts lib/index.d.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.12",
    "jsdom": "^24.1.3",
    "lodash": "^4.17.21",
    "pdfjs-dist": "5.7.284",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue": "^3.5.12"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForMachaca/vue-office-next.git",
    "directory": "core/packages/vue-pdf"
  },
  "keywords": [
    "vue",
    "docx",
    "pdf",
    "ppt",
    "excel",
    "docx-preview",
    "excel-preview",
    "pdf-preview"
  ],
  "license": "MIT",
  "author": "hit757 and contributors",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
